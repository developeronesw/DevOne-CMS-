{
  "name": "devone-cms",
  "version": "2.0.0-alpha.3",
  "private": true,
  "description": "DevOne CMS — Performance, Security, Design",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "local": "tsx runtime/local-server.ts",
    "cloudflare:deploy": "vite build && wrangler deploy",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:typegen": "wrangler types",
    "test": "tsx --test tests/**/*.test.ts",
    "test:core": "tsx --test tests/core.test.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.1",
    "wrangler": "^4.131.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9"
  }
}
