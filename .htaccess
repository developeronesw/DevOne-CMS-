DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Keep real files and folders working normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# DevOne API front controller.
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]

# DevOne public front controller. The CMS resolves /slug and /page/slug.
RewriteRule ^ index.php [QSA,L]
</IfModule>
